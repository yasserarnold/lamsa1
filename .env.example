# ============================================================================
# متغيرات البيئة العامة (Client) — كل ما يبدأ بـ VITE_ يُحقن في الواجهة.
# انسخ هذا الملف إلى .env ثم عبّئ القيم. لا ترفع .env إلى Git.
# ============================================================================

# ----------------------------------------------------------------------------
# VITE_PUBLIC_SITE_URL — الدومين القانوني (Canonical) لروابط المشاركة
# ----------------------------------------------------------------------------
# يُستخدم في:
#   - رابط المعاينة/المشاركة في لوحة التحكم
#   - حمولة QR Code
#   - كتابة رابط البروفايل على بطاقة NFC
#   - حقل URL داخل vCard
#
# متى يجب ضبطه؟
#   - إذا كنت تريد إجبار دومين محدد (مثلاً دومين مخصص) بغضّ النظر عن أين
#     يُقدَّم الموقع فعليًا.
#   - إذا كنت تختبر من دومين المعاينة ولا تريد أن يُستخدم الـ fallback.
#
# متى يمكن تجاهله؟
#   - إذا كنت تفتح الموقع من الدومين المخصص مباشرة، سيتم اكتشافه تلقائيًا
#     من window.location.origin (auto-follow).
#
# ✅ أمثلة صحيحة (الدومين المنشور — Published):
#   VITE_PUBLIC_SITE_URL=https://krotak.lovable.app
#   VITE_PUBLIC_SITE_URL=https://cards.mycompany.com
#   VITE_PUBLIC_SITE_URL=https://www.mycompany.com
#
# ❌ أمثلة خاطئة (لا تستخدم دومين المعاينة/المحرّر — Preview/Editor):
#   VITE_PUBLIC_SITE_URL=https://id-preview--xxx.lovable.app
#   VITE_PUBLIC_SITE_URL=https://xxx.lovableproject.com
#   VITE_PUBLIC_SITE_URL=http://localhost:8080
#   VITE_PUBLIC_SITE_URL=krotak.lovable.app          # مفقود https://
#   VITE_PUBLIC_SITE_URL=https://krotak.lovable.app/ # سلاش زائد في النهاية
#
# الفرق بين الدومينات:
#   • Preview  → id-preview--<uuid>.lovable.app  (يتغير، للمعاينة فقط)
#   • Editor   → <slug>.lovableproject.com       (بيئة المحرر)
#   • Published → <slug>.lovable.app             (رابط النشر الثابت)
#   • Custom   → yourdomain.com                  (الدومين المخصص بعد الربط)
#
# القاعدة: استخدم دائمًا الدومين المنشور أو المخصص — لا تضع دومين المعاينة.
# ----------------------------------------------------------------------------
VITE_PUBLIC_SITE_URL=https://krotak.lovable.app

# ----------------------------------------------------------------------------
# متغيرات Lovable Cloud (تُدار تلقائيًا — لا تُعدّل يدويًا)
# ----------------------------------------------------------------------------
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
# VITE_SUPABASE_PROJECT_ID=<project-ref>